{
  "name": "@charity-mono/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./generated/prisma/client.ts",
      "default": "./dist/src/client.js"
    }
  },
  "files": [
    "dist",
    "generated",
    "prisma"
  ],
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "build": "pnpm run prisma:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm run prisma:generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^7.4.2"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "prisma": "^7.4.2",
    "typescript": "^5.9.3"
  }
}
