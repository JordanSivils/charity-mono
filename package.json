{
  "name": "charity-mono",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "lint": "pnpm run lint:check",
    "lint:check": "pnpm -r --if-present run lint:check",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "check": "pnpm run lint:check && pnpm run typecheck && pnpm run test && pnpm run build",
    "database:generate": "pnpm --filter @charity-mono/database run prisma:generate",
    "database:validate": "pnpm --filter @charity-mono/database run prisma:validate",
    "database:migrate:dev": "pnpm --filter @charity-mono/database run prisma:migrate:dev",
    "database:migrate:status": "pnpm --filter @charity-mono/database run prisma:migrate:status",
    "tool:geocode:typecheck": "pnpm --filter @charity-mono/geocode-worker run typecheck",
    "tool:geocode:build": "pnpm --filter @charity-mono/geocode-worker run build",
    "tool:geocode:run": "pnpm run tool:geocode:build && pnpm --filter @charity-mono/geocode-worker run full-geocode",
    "service:geocode:typecheck": "pnpm --filter @charity-mono/geocode-worker-service run typecheck",
    "service:geocode:build": "pnpm --filter @charity-mono/geocode-worker-service run build",
    "service:geocode:run": "pnpm run service:geocode:build && pnpm --filter @charity-mono/geocode-worker-service run full-geocode",
    "tool:irs-import:typecheck": "pnpm --filter @charity-mono/irs-data-import run typecheck",
    "tool:irs-import:build": "pnpm --filter @charity-mono/irs-data-import run build",
    "tool:irs-import:run": "pnpm run tool:irs-import:build && pnpm --filter @charity-mono/irs-data-import run start",
    "service:irs-upload:lint": "pnpm --filter @charity-mono/irs-data-upload run lint:check",
    "service:irs-upload:typecheck": "pnpm --filter @charity-mono/irs-data-upload run typecheck",
    "service:irs-upload:test": "pnpm --filter @charity-mono/irs-data-upload run test",
    "service:irs-upload:sam-validate": "pnpm --filter @charity-mono/irs-data-upload run validate",
    "service:irs-upload:sam-build": "pnpm --filter @charity-mono/irs-data-upload run build",
    "service:api:typecheck": "pnpm --filter @charity-mono/api run typecheck",
    "service:api:build": "pnpm --filter @charity-mono/api run build",
    "app:platform-web:typecheck": "pnpm --filter @charity-mono/platform-web run typecheck",
    "app:platform-web:lint": "pnpm --filter @charity-mono/platform-web run lint:check",
    "app:platform-web:build": "pnpm --filter @charity-mono/platform-web run build"
  }
}
