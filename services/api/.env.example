# PostgreSQL connection string for the API-owned Prisma client.
DATABASE_URL=
# Redis connection URL for API-key rate-limit counters.
REDIS_URL=
# Secret used when decrypting stored API-key hashes.
API_KEY_PEPPER=
# HTTP listen port; defaults to 3000.
PORT=3000
# Pino log level; defaults to info.
PINO_LOG_LEVEL=info
