generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Charity {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ein                String   @unique
  name               String?
  ico                String?
  street             String?
  city               String?
  state              String?
  zip                String?
  group              String?
  subsection         String?
  affiliation        String?
  classification     String?
  ruling             String?
  deductibility      String?
  foundation         String?
  activity           String?
  organization       String?
  status             String?
  tax_period         String?
  filing_req_code    String?
  pf_filing_req_code String?
  account_paid       String?
  asset_amount       Decimal? @db.Decimal(14, 2)
  income_amount      Decimal? @db.Decimal(14, 2)
  revenue_amount     Decimal? @db.Decimal(14, 2)
  ntee_code          String?
  ntee_group         String?
  hash_value         String?
  address_hash       String?

  lat                Decimal?  @db.Decimal(9, 6)
  lng                Decimal?  @db.Decimal(9, 6)
  geocode_status     Int?
  geocoded_at        DateTime? @db.Timestamptz(6)
  location           Unsupported("geography(Point,4326)")?

  @@index([zip])
  @@index([state, city])
  @@index([ntee_group])
  @@index([ntee_code])
  @@index([deductibility])
  @@index([status])
  @@index([geocode_status])
}

model CharityStaging {
  ein                String   @unique
  name               String?
  ico                String?
  street             String?
  city               String?
  state              String?
  zip                String?
  group              String?
  subsection         String?
  affiliation        String?
  classification     String?
  ruling             String?
  deductibility      String?
  foundation         String?
  activity           String?
  organization       String?
  status             String?
  tax_period         String?
  filing_req_code    String?
  pf_filing_req_code String?
  account_paid       String?
  asset_amount       Decimal? @db.Decimal(14, 2)
  income_amount      Decimal? @db.Decimal(14, 2)
  revenue_amount     Decimal? @db.Decimal(14, 2)
  ntee_code          String?
  ntee_group         String?
  hash_value         String?
  address_hash       String?

  lat                Decimal?  @db.Decimal(9, 6)
  lng                Decimal?  @db.Decimal(9, 6)
  geocode_status     Int?
  geocoded_at        DateTime? @db.Timestamptz(6)

  @@index([ein])
}

model ApiKey {
  id          String    @id @default(uuid())
  environment ApiKeyEnv
  keyHash     String    @unique
  keyPrefix   String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, environment])
  @@index([userId, environment, isActive])
}

model User {
  id       String   @id @default(uuid())
  clerkId  String   @unique
  email    String   @unique
  name     String?

  tierId   String
  tier     Tier    @relation(fields: [tierId], references: [id])

  apiKeys  ApiKey[]

  billing UserBilling?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Tier {
  id   String @id @default(uuid())
  name String @unique // FREE, STARTER, GROWTH, PRO

  dailyLimit Int

  resultLimit Int

  nearbyRadiusMaxMiles Int
  nearbyResultLimit    Int

  stripePriceId String? @unique

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserBilling {
  id     String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  status String? // active, trialing, past_due, canceled, unpaid, etc.

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GeocodeStaging {
  ein String @id
  zip String
  lat Decimal?
  lng Decimal?
  match_status String
}

enum ApiKeyEnv {
  LIVE
  DEV
}

model FallbackGeocodes {
  zip      String   @id @db.VarChar(10)
  lat      Decimal  @db.Decimal(9, 6)
  lng      Decimal  @db.Decimal(9, 6)
  location Unsupported("geography(Point,4326)")?
  @@index([location], type: Gist)
}
