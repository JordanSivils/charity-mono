// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Charity {
  id                 String     @id @default(uuid())
  ein                String     @unique
  name               String?  
  ico                String?  
  street             String?  
  city               String?  
  state              String?  
  zip                String?  
  group              Int?  
  subsection         Int?  
  affiliation        Int?  
  classification     Int?  
  ruling             Int?  
  deductibility      Int?  
  foundation         Int?  
  activity           Int?  
  organization       Int?  
  status             Int?  
  tax_period         Int?  
  filing_req_code    Int?  
  pf_filing_req_code Int?  
  account_paid       Int?
  asset_amount       Decimal?    @db.Decimal(14, 2)
  income_amount      Decimal?   @db.Decimal(14, 2)
  revenue_amount     Decimal?   @db.Decimal(14, 2)
  ntee_code          String?
  ntee_code_valid Boolean?
  ntee_group         String?
  hash_value         String?

  @@index([zip])
  @@index([state, city])
  @@index([ntee_group])
  @@index([status])
  @@index([deductibility])
}

model CharityStaging {
  ein                String     @unique
  name               String?  
  ico                String?  
  street             String?  
  city               String?  
  state              String?  
  zip                String? 
  group              Int?  
  subsection         Int?  
  affiliation        Int?  
  classification     Int?  
  ruling             Int?  
  deductibility      Int?  
  foundation         Int?  
  activity           Int?  
  organization       Int?  
  status             Int?  
  tax_period         Int?  
  filing_req_code    Int?  
  pf_filing_req_code Int?  
  account_paid       Int?  
  asset_amount       Decimal?    @db.Decimal(14, 2)
  income_amount      Decimal?   @db.Decimal(14, 2)
  revenue_amount     Decimal?   @db.Decimal(14, 2)
  ntee_code          String?  
  ntee_code_valid    Boolean?
  ntee_group         String?
  hash_value         String?
}